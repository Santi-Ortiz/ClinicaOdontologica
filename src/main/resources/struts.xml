<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

	<constant name="struts.devMode" value="true" />

	<package name="default" extends="struts-default, tiles-default">
	
		<!-- Layout Principal -->
		<action name="home">
			<result name="success" type="tiles">main-layout</result>	
		</action>
		
		<!-- Landing Page -->
		<action name="">
			<result name="success" type="tiles">inicio</result>
		</action>
		
		
		<!--  Vistas de Persona -->
		
		<!-- Página principal de Personas -->
		<action name="inicio-personas">
			<result name="success" type="tiles">persona.landing</result>
		</action>
		
		<!-- Vista de Registro de Personas -->
		<action name="registro-personas">
			<result name="success" type="tiles">persona.registro</result>
			<result name="error" type="tiles">persona.error</result>
		</action>
		
		<!-- Obtener Todas las personas -->
		<action name="personas" class="com.clinica.action.PersonaAction" method="obtenerPersonas">
			<result name="success" type="tiles">persona.listar</result>
			<result name="error" type="redirect">persona.error</result>
			<result name="input">persona.listar</result>
		</action>
		
		<!-- Creación de Persona -->
		<action name="crear" class="com.clinica.action.PersonaAction"
			method="crearPersona">
			<result name="success">persona.success</result>
			<result name="error" type="redirect">persona.error</result>
			<result name="input">persona.success</result>
		</action>

		<!-- Obtener Persona por Id -->
		<action name="buscarPersona"
			class="com.clinica.action.PersonaAction" method="obtenerPersonaPorId">
			<result name="success">/personaPorId.jsp</result>
			<result name="error" type="redirect">persona.error</result>
			<result name="input">/personaPorId.jsp</result>
		</action>

		<!-- Actualizar Persona -->
		<action name="actualizarPersona"
			class="com.clinica.action.PersonaAction" method="actualizarPersona">
			<result name="success">/actualizarPersona.jsp</result>
			<result name="error" type="redirect">persona.error</result>
			<result name="input">/actualizarPersona.jsp</result>
		</action>

		<!-- Eliminar Persona -->
		<action name="eliminarPersona"
			class="com.clinica.action.PersonaAction" method="eliminarPersona">
			<result name="success">persona.success</result>
			<result name="error" type="redirect">persona.error</result>
			<result name="input">persona.success</result>
		</action>
		
		<!-- Vistas de Odontologo -->
		
		<!-- Página Principal de Odontologo -->
		<action name="inicio-odontologo">
			<result name="success" type="tiles">odontologo.landing</result>
			<result name="error" type="tiles">odontologo.error</result>
		</action>
		
		<!-- Crear Odontologo -->
		<action name="registro-odontologo">
			<result name="success" type="tiles">odontologo.registro</result>
			<result name="error" type="tiles">odontologo.error</result>
		</action>

		<!-- Listar Odontologos -->
		<action name="listar-odontologo">
			<result name="success" type="tiles">odontologo.listar</result>
			<result name="error" type="tiles">odontologo.error</result>
		</action>

		<!-- NAVEGACIÓN -->


		<action name="actualizar">
			<result>/actualizarPersona.jsp</result>
		</action>

	</package>

</struts>