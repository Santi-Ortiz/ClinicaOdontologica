<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE tiles-definitions PUBLIC
       "-//Apache Software Foundation//DTD Tiles Configuration 2.0//EN"
       "http://tiles.apache.org/dtds/tiles-config_2_0.dtd">
	
	
<tiles-definitions>

	<!-- Plantilla (layout) principal -->
	<definition name="mainLayout" template="/jsp/layout/MainLayout.jsp">
		<put-attribute name="title" value="/jsp/layout/title.jsp" />
		<put-attribute name="header" value="/jsp/layout/header.jsp" />
		<put-attribute name="nav" value="/jsp/layout/nav.jsp"/>
		<put-attribute name="body" value="/jsp/layout/body.jsp" />
	</definition>
	
	<!-- Reutilización de mainlayout-->
    <definition name="home.tiles" extends="mainLayout">
        <put-attribute name="body" value="/jsp/layout/home.jsp"/>
    </definition>

</tiles-definitions>
       
       
   
       

